# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nirvorjoggo_bazar?schema=public"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# File uploads (receipts, product images)
UPLOAD_DIR=./public/uploads
MAX_UPLOAD_SIZE_MB=5

# ---------------------------------------------------------------------------
# bKash Payment Gateway (Checkout / PGW v1.2.0-beta)
# Docs: https://developer.bka.sh/
# ---------------------------------------------------------------------------
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_CALLBACK_URL=http://localhost:3000/api/payments/bkash/callback

# ---------------------------------------------------------------------------
# Nagad Payment Gateway (Checkout API)
# Docs: https://developer.mynagad.com/
# ---------------------------------------------------------------------------
NAGAD_BASE_URL=https://api.mynagad.com/api/dfs
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
# PEM-encoded, base64 single-line (\n escaped) private key issued by Nagad
NAGAD_MERCHANT_PRIVATE_KEY=
# PEM-encoded, base64 single-line (\n escaped) public key issued BY Nagad (to verify their responses)
NAGAD_PUBLIC_KEY=
NAGAD_CALLBACK_URL=http://localhost:3000/api/payments/nagad/callback

# ---------------------------------------------------------------------------
# Rocket (DBBL Mobile Banking) - manual/semi-automated reconciliation flow.
# Rocket has no public tokenized checkout API for merchants; integration is
# via DBBL's merchant USSD/SMS-confirmation reconciliation process.
# ---------------------------------------------------------------------------
ROCKET_MERCHANT_NUMBER=
ROCKET_MERCHANT_ACCOUNT_TYPE=Personal
ROCKET_VERIFICATION_API_URL=
ROCKET_VERIFICATION_API_KEY=

# ---------------------------------------------------------------------------
# SSLCommerz
# Docs: https://developer.sslcommerz.com/
# ---------------------------------------------------------------------------
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SUCCESS_URL=http://localhost:3000/api/payments/sslcommerz/success
SSLCOMMERZ_FAIL_URL=http://localhost:3000/api/payments/sslcommerz/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:3000/api/payments/sslcommerz/cancel
SSLCOMMERZ_IPN_URL=http://localhost:3000/api/payments/sslcommerz/ipn

# ---------------------------------------------------------------------------
# Steadfast Courier
# Docs: https://steadfast.com.bd/api/v1 (docs.steadfast.com.bd)
# ---------------------------------------------------------------------------
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# ---------------------------------------------------------------------------
# Pathao Courier
# Docs: https://merchant.pathao.com/courier/developer
# ---------------------------------------------------------------------------
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
